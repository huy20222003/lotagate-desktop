{
  "name": "@lotagate/desktop",
  "productName": "LotaGate Desktop",
  "version": "0.1.0",
  "private": true,
  "author": "LotaGate",
  "description": "LotaGate Desktop agent workspace for development and automation.",
  "type": "commonjs",
  "main": ".vite/build/index.js",
  "overrides": {
    "cross-zip": "$cross-zip",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.5",
    "tar": "7.5.22",
    "tmp": "0.2.7"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run cli:build && electron-vite dev",
    "cli:build": "npm --prefix ../cli run build",
    "build": "electron-vite build",
    "cli:link": "node scripts/link-cli.mjs",
    "cli:unlink": "node scripts/unlink-cli.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:component": "vitest run src/renderer",
    "test:contract": "vitest run src/contracts src/main/api",
    "test:e2e": "npm run package && playwright test",
    "lint": "eslint .",
    "check:file-size": "node scripts/check-file-sizes.mjs",
    "cli:prepare": "node scripts/prepare-cli-runtime.mjs",
    "speech:prepare": "node scripts/prepare-speech-runtime.mjs",
    "prepackage": "npm run speech:prepare",
    "package": "electron-forge package",
    "premake": "node scripts/prepare-speech-lifecycle.mjs",
    "make": "electron-forge make",
    "make:installers": "node scripts/build-installers.mjs",
    "release:target": "node scripts/build-release-matrix.mjs",
    "package:smoke": "npm run build && npm run check:file-size && npm run package"
  },
  "dependencies": {
    "@lotagate/cli": "0.1.24",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@vitejs/plugin-react": "5.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "2.1.1",
    "electron-vite": "5.0.0",
    "lucide-react": "0.468.0",
    "mermaid": "11.17.2",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "^4.4.2",
    "swiper": "14.2.0",
    "wavesurfer.js": "^7.12.11",
    "ws": "^8.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-pkg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-wix": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@playwright/test": "1.55.1",
    "@swc/core": "1.16.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "20.19.43",
    "@types/qrcode": "^1.5.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "cross-zip": "file:vendor/cross-zip",
    "electron": "44.0.0",
    "eslint": "9.39.5",
    "jsdom": "26.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
